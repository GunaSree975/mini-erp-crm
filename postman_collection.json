{
  "info": {
    "_postman_id": "nexus-mini-erp-crm-api-collection",
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete REST API Collection for Mini ERP & CRM Portal with Auth, Roles, Customer CRM, Products & Inventory, and Sales Challans.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Sales Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@company.com\",\n  \"password\": \"Sales123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Warehouse Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@company.com\",\n  \"password\": \"Warehouse123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Accounts Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@company.com\",\n  \"password\": \"Accounts123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer CRM Module",
      "item": [
        {
          "name": "Get All Customers (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers?page=1&limit=10&search=&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Create Customer Account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Vikramaditya Rao\",\n  \"mobileNumber\": \"+919811223344\",\n  \"email\": \"vikram@titanindustries.com\",\n  \"businessName\": \"Titan Industrial Supplies\",\n  \"gstNumber\": \"27TITAN1234F1Z9\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"Building 12, Tech Park, Pune, MH\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-08-20\",\n  \"notes\": \"Interested in high volume fasteners contract.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "Add Follow-up Note to Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called customer. Requested revised pricing for 500 units.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/CUSTOMER_ID/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "CUSTOMER_ID", "follow-ups"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Products & Stock Inventory Module",
      "item": [
        {
          "name": "Get Products List (with Low Stock Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?lowStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "lowStock", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Create Product SKU",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Industrial Angle Grinder 850W\",\n  \"sku\": \"SKU-TOOL-GRINDER-850\",\n  \"category\": \"Power Tools\",\n  \"unitPrice\": 3200,\n  \"currentStock\": 25,\n  \"minStockAlertInt\": 5,\n  \"locationWarehouse\": \"Warehouse B - Shelf 04\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Record Stock Movement (IN / OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 10,\n  \"movementType\": \"IN\",\n  \"reason\": \"Supplier Purchase Receipt #PO-8821\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/PRODUCT_ID/stock-movement",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "PRODUCT_ID", "stock-movement"]
            }
          }
        },
        {
          "name": "Get Stock Movement Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/movements/log",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "movements", "log"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sales Challan Module",
      "item": [
        {
          "name": "Get All Sales Challans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans"]
            }
          }
        },
        {
          "name": "Create Sales Challan (DRAFT or CONFIRMED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/challans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans"]
            }
          }
        },
        {
          "name": "Confirm Draft Challan (Deduct Inventory)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/challans/CHALLAN_ID/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans", "CHALLAN_ID", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Dashboard Statistics",
      "item": [
        {
          "name": "Get Dashboard KPI & Stock Alerts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "stats"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ]
}
